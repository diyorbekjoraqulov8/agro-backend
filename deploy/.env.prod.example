# cp .env.prod.example .env.prod && chmod 600 .env.prod   (.env.prod git'ga va image'ga tushmaydi)
# Sir yasash: openssl rand -hex 24

# DNS A yozuvi VPS IP'siga
DOMAIN=dropy.uz
DB_PASSWORD=
SATELLITE_INTERNAL_KEY=

# Birinchi admin (faqat birinchi ishga tushishda; kirgach parolni almashtiring va bu ikkisini o'chiring)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Telegram — PROD bot (dev bot bilan BIR XIL token ishlatmang: bitta token — bitta polling jarayon)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
MINIAPP_URL=https://agro-miniapp.vercel.app/
TELEGRAM_SUPPORT_CHAT_ID=

# Ob-havo: tijorat uchun Open-Meteo kaliti SHART (bepul API — faqat notijorat)
OPEN_METEO_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# AI maslahat (ixtiyoriy; tugma admin Sozlamalar → Bot menyusi'da yoqiladi)
ANTHROPIC_API_KEY=
