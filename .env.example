# Nusxa oling:  cp .env.example .env   (.env git'ga tushmaydi)
# application.yml uni `spring.config.import` orqali o'qiydi.
# Haqiqiy environment o'zgaruvchilari shu fayldagidan ustun turadi.

DB_URL=jdbc:postgresql://localhost:5432/agro
DB_USERNAME=postgres
DB_PASSWORD=

# Prod: private key'ni classpath'dan emas, tashqi fayldan bering
# JWT_PRIVATE_KEY=file:/etc/app/keys/private.pem

# Python satellite-service: ikkala tomonda bir xil, kamida 16 belgi [A-Za-z0-9_-]
# Yasash: openssl rand -hex 24
SATELLITE_URL=http://localhost:8090
SATELLITE_INTERNAL_KEY=

# Telegram bot: @BotFather → /newbot. Dev va prod uchun ALOHIDA bot (bitta token — bitta jarayon)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# S6: Mini App manzili (https majburiy)
MINIAPP_URL=
# Ixtiyoriy: yangi murojaatlar shu guruhga ham keladi (manfiy id, masalan -1001234567890)
TELEGRAM_SUPPORT_CHAT_ID=

# Yuklangan fayllar papkasi. Default — loyiha ichidagi storage/files. Prod'da — backup qilinadigan disk.
# Bo'sh qiymat bilan YOZMANG (FILES_DIR=) — bo'sh satr default'ni bekor qiladi
# FILES_DIR=/var/lib/agro/files

# Bizning API'ning ommaviy https manzili (prod domen yoki lokal sinovda tunnel: cloudflared/ngrok).
# Bo'sh — onboarding oxirida inline "🗺 Dalani belgilash" tugmasi chiqmaydi (pastki menyu tugmasi ishlaydi)
# PUBLIC_API_URL=https://api.example.uz

# Ob-havo (Open-Meteo). Boʻsh — bepul API (faqat notijorat). Prod: OPEN_METEO_URL=https://customer-api.open-meteo.com/v1/forecast + kalit
# OPEN_METEO_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
# WEATHER_ENABLED=false   # ogohlantirish job'ini o'chirish
# MONITORING_JOB_ENABLED=false   # C3 monitoring job'ini o'chirish (sozlamalar — admin panelda)

# C4: AI maslahatchi (Claude). console.anthropic.com → API Keys (Claude Pro obunasi API emas). Bo'sh — o'chiq
ANTHROPIC_API_KEY=
